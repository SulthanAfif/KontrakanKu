{
  "expo": {
    "name": "Kontrakanku Admin",
    "slug": "kontrakanku-admin",
    "scheme": "kontrakanku",
    "version": "1.0.0",
    "icon": "./assets/logo.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto kamar dari galeri perangkat."
        }
      ],
      "expo-web-browser",
      "expo-sqlite"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f6f1"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.sulthanafif.kontrakankuadmin"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "fad9fe65-0d90-44b7-bb9c-48869204d700"
      }
    }
  }
}
