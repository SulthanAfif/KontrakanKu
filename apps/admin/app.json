{
  "expo": {
    "name": "Kontrakanku Admin",
    "slug": "kontrakanku-admin",
    "scheme": "kontrakanku",
    "version": "1.0.0",
    "icon": "./assets/logo.png",
    "plugins": [["expo-image-picker", { "photosPermission": "Pilih foto kamar dari galeri perangkat." }], "expo-web-browser"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f6f1"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": { "favicon": "./assets/logo.png" }
  }
}
